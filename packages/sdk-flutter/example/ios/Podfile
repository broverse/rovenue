# rovenue_flutter_ios.podspec targets iOS 15.0, but its `Rovenue` pod
# dependency (packages/sdk-swift/Rovenue.podspec) requires 16.0
# (arm64-device-only static lib) — the higher floor wins.
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # Dev override (spec §4.6): rovenue_flutter_ios.podspec declares
  # `s.dependency 'Rovenue', '0.16.0'`, resolved from CocoaPods Trunk — but
  # the `Rovenue` pod (packages/sdk-swift) isn't published there yet. Point
  # it at the monorepo checkout instead so this example app builds without
  # a published pod. Remove this override once `Rovenue` ships to Trunk.
  pod 'Rovenue', :path => '../../../sdk-swift'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Work around a CocoaPods bug when `Rovenue`'s SWIFT_INCLUDE_PATHS
  # (`Rovenue.podspec`'s `pod_target_xcconfig`, pointed at
  # `Sources/RovenueFFI` so the generated `import RovenueFFI` Clang module
  # resolves — a `:path`-relative `$(PODS_TARGET_SRCROOT)`) propagates to
  # `rovenue_flutter_ios`'s own SWIFT_INCLUDE_PATHS: CocoaPods correctly
  # re-derives the `../` hop count (`PODS_ROOT` here means the `Pods/`
  # subdirectory the `Pods.xcodeproj` actually lives in, one level below
  # this Podfile — 4 hops up from there lands on `packages/`), but drops
  # the `RovenueFFI` leaf path segment and substitutes `Rovenue` instead,
  # so `rovenue_flutter_ios`'s `import Rovenue` fails to resolve the
  # transitive `RovenueFFI` Clang module ("Unable to resolve module
  # dependency: 'RovenueFFI'"). Not fixable from `Rovenue.podspec` (out of
  # scope — see task-8-context.md's hard constraints): pin the correct
  # path directly on the affected pod targets instead.
  rovenue_ffi_include_path = '$(PODS_ROOT)/../../../../sdk-swift/Sources/RovenueFFI'
  installer.pods_project.targets.each do |target|
    next unless ['Rovenue', 'rovenue_flutter_ios'].include?(target.name)
    target.build_configurations.each do |config|
      existing = Array(config.build_settings['SWIFT_INCLUDE_PATHS'])
      config.build_settings['SWIFT_INCLUDE_PATHS'] = (['$(inherited)'] + existing + [rovenue_ffi_include_path]).uniq
    end
  end
end
