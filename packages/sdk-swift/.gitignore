# Release artifacts produced by scripts/release-pod.sh
build/
Rovenue-*.zip

# The Apple binary artifact: built by scripts/build-xcframework.sh, never
# committed. (Also ignored repo-wide as **/RovenueFFI.xcframework; kept here so
# this package states its own build products.) The bare `Sources/Rovenue/*.a`
# entry covers the single-slice static libs this package used to vendor before
# the xcframework replaced them.
RovenueFFI.xcframework
Sources/Rovenue/*.a

# UniFFI-generated bindings (regenerated by build-bindings.sh — same
# posture as packages/sdk-kotlin/src/main/kotlin/dev/rovenue/sdk/generated)
Sources/Rovenue/Generated/

# Xcode noise (in case anyone opens Package.swift in Xcode locally)
.swiftpm/
.build/
*.xcodeproj/
