{
  "name": "@rovenue/web-sdk",
  "version": "0.16.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./paywall": {
      "types": "./dist/paywall.d.ts",
      "import": "./dist/paywall.js",
      "require": "./dist/paywall.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --minWorkers=1 --maxWorkers=2"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3.2.6",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "@rovenue/shared": "workspace:*",
    "@rovenue/paywall-renderer": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "AGPL-3.0-only",
  "description": "Rovenue Web SDK \u2014 entitlements, placements, paywalls and Stripe checkout from the browser.",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ]
}
