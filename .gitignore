apps/dashboard/src/routeTree.gen.ts

# Rust
/target/
**/target/
Cargo.lock.bak

# Swift
packages/sdk-swift/.build/
packages/sdk-swift/.swiftpm/
packages/sdk-flutter/rovenue_flutter_ios/ios/.build/
packages/sdk-flutter/rovenue_flutter_ios/ios/.swiftpm/

# Kotlin / Android
packages/sdk-kotlin/build/
packages/sdk-kotlin/.gradle/
packages/sdk-kotlin/local.properties
packages/sdk-flutter/rovenue_flutter_android/android/.gradle/
packages/sdk-flutter/rovenue_flutter_android/android/local.properties
examples/android-kotlin/.gradle/
examples/android-kotlin/local.properties
examples/android-kotlin/app/.cxx/

# Generated UniFFI bindings (regenerated by build)
packages/sdk-swift/Sources/Rovenue/Generated/*
!packages/sdk-swift/Sources/Rovenue/Generated/.gitkeep
packages/sdk-kotlin/src/main/kotlin/dev/rovenue/sdk/generated/*
!packages/sdk-kotlin/src/main/kotlin/dev/rovenue/sdk/generated/.gitkeep

# Cross-compiled Android native libs (built by build-android.sh, bundled in the AAR)
packages/sdk-kotlin/src/main/jniLibs/**/*.so
!packages/sdk-kotlin/src/main/jniLibs/.gitkeep

# Dart / Flutter — path-anchored like the Swift/Kotlin blocks above, so these
# never swallow a `build/` or `.dart_tool/` somewhere else in the monorepo.
packages/sdk-flutter/**/.dart_tool/
packages/sdk-flutter/**/build/
.flutter-plugins*
Pods/
*.iml
# packages/sdk-flutter/* are libraries, not apps — pub convention is to
# NOT commit pubspec.lock for library packages (only apps commit it).
pubspec.lock
# ...except packages/sdk-flutter/example, which IS an application package
# (Task 8) — pub convention is that applications DO commit their lockfile.
!packages/sdk-flutter/example/pubspec.lock

# Apple binary artifacts are built by packages/sdk-swift/scripts/build-xcframework.sh,
# never committed. A 32 MB librovenue_ffi.a used to live in the tree — and it
# was the wrong platform slice for its entire life.
**/RovenueFFI.xcframework
packages/sdk-swift/build/

# Built artifacts of the Web SDK — produced by tsup, never committed.
packages/sdk-web/dist/

# Per-SDK API reference output (ROADMAP §11, scripts/generate-sdk-docs.sh).
# rustdoc (target/doc), the DocC archive (packages/sdk-swift/.build/), and
# Dokka HTML (packages/sdk-kotlin/build/) are already covered by the
# /target/ and per-package .build/ / build/ rules above.
packages/sdk-rn/docs/
packages/sdk-web/docs/
packages/sdk-flutter/rovenue_flutter/doc/
